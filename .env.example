# MUXCORE_MODULE_ID=distributed-lock-sqlite
# LOCK_DB_PATH=/var/lib/distributed-lock-sqlite/locks.db
# LOCK_GRPC_ADDR=127.0.0.1:9604
# LOCK_SWEEP_INTERVAL=10s

# TLS (enabled by default; auto-generated under ~/.muxcore/tls/distributed-lock-sqlite)
# LOCK_TLS_CERT=
# LOCK_TLS_KEY=
# LOCK_TLS_CA=
# LOCK_TLS_DIR=

# Dev-only plaintext gRPC (inbound and outbound)
# MUXCORE_INSECURE_DISABLE_TLS=true
# MUXCORE_GRPC_INSECURE=true

# MVP_ENABLE_DISTRIBUTED_LOCK=1
